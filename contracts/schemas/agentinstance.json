{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/agentinstance.json",
  "title": "AgentInstance",
  "description": "An agent bound to a user, team or service, with its own identity (PRD section 5). Usually generated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "type": "string", "const": "muistamo.dev/v1" },
    "kind": { "type": "string", "const": "AgentInstance" },
    "metadata": { "$ref": "common/objectmeta.json" },
    "spec": {
      "title": "AgentInstanceSpec",
      "type": "object",
      "additionalProperties": false,
      "required": ["templateRef", "binding", "state"],
      "properties": {
        "templateRef": {
          "title": "TemplateRef",
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string" },
            "version": {
              "description": "Template version number assigned by the server, for example \"3\".",
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "binding": {
          "title": "InstanceBinding",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ref"],
          "properties": {
            "type": { "type": "string", "enum": ["user", "team", "service"] },
            "ref": { "type": "string" }
          }
        },
        "identityRef": {
          "description": "Identity ID of the instance in the identity provider.",
          "type": "string"
        },
        "sponsor": { "type": "string" },
        "delegate": { "type": "string" },
        "personalLayerRef": { "type": "string" },
        "state": {
          "description": "Must be requested on create; changes only through transitions.",
          "$ref": "common/instancestate.json"
        },
        "costCentre": { "type": "string" }
      }
    }
  }
}
