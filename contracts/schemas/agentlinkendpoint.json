{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/agentlinkendpoint.json",
  "title": "AgentLinkEndpoint",
  "description": "One end of an AgentLink. Release 1 selects agents by template; clones, instances and labels come later.",
  "type": "object",
  "additionalProperties": false,
  "required": ["template"],
  "properties": {
    "template": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" }
  }
}
