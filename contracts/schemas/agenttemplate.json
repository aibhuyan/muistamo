{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/agenttemplate.json",
  "title": "AgentTemplate",
  "description": "A reusable agent definition owned by the company (PRD section 5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "type": "string", "const": "muistamo.dev/v1" },
    "kind": { "type": "string", "const": "AgentTemplate" },
    "metadata": { "$ref": "common/objectmeta.json" },
    "spec": {
      "title": "AgentTemplateSpec",
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "modelAlias"],
      "properties": {
        "purpose": { "type": "string" },
        "riskTier": { "type": "string", "enum": ["low", "medium", "high"] },
        "modelAlias": {
          "description": "Name of a ModelAlias, never a concrete provider model.",
          "type": "string"
        },
        "knowledgePacks": {
          "type": "array",
          "items": {
            "title": "KnowledgePackRef",
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "version": {
                "description": "Version constraint, for example 3.x to follow minor updates.",
                "type": "string"
              }
            }
          }
        },
        "tools": { "type": "array", "items": { "type": "string" } },
        "dataClasses": { "type": "array", "items": { "type": "string" } },
        "autonomy": { "type": "string" },
        "assignment": {
          "title": "AgentTemplateAssignment",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hrJobCodes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "budget": {
          "title": "AgentTemplateBudget",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "perInstanceMonthlyEUR": { "type": "number", "minimum": 0 }
          }
        },
        "evaluationSet": { "type": "string" }
      }
    }
  }
}
