{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/cataloguedecision.json",
  "title": "CatalogueDecision",
  "description": "An approver's decision on a catalogue request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "reason"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
