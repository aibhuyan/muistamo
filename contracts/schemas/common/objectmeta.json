{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/common/objectmeta.json",
  "title": "ObjectMeta",
  "description": "Metadata shared by every Muistamo YAML kind.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": {
      "description": "Unique name of the object within its tenant.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "owner": {
      "description": "Owning team or person reference.",
      "type": "string"
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
