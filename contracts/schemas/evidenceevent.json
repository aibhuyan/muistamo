{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/evidenceevent.json",
  "title": "EvidenceEvent",
  "description": "One signed, hash-chained evidence event. The hashed body and signature are defined in control-plane/evidencechain; verify chains with mst evidence verify.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant", "seq", "occurredAt", "actor", "action", "subject", "before", "after",
               "requestId", "prevHash", "hash", "keyId", "signature"],
  "properties": {
    "tenant": { "type": "string", "format": "uuid" },
    "seq": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "actor": { "type": "string" },
    "action": { "type": "string" },
    "subject": {
      "title": "EvidenceSubject",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "before": { "description": "State before the action, or null." },
    "after": { "description": "State after the action, or null." },
    "requestId": { "type": "string" },
    "prevHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "keyId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "signature": { "description": "Ed25519 signature over the hash bytes, base64.", "type": "string" }
  }
}
