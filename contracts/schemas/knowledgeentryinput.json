{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/knowledgeentryinput.json",
  "title": "KnowledgeEntryInput",
  "description": "A new entry captured into the caller's personal layer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "type",
    "title",
    "body"
  ],
  "properties": {
    "key": {
      "description": "Stable key; the most specific layer wins for the same key.",
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 120
    },
    "type": {
      "type": "string",
      "enum": [
        "skill",
        "fact",
        "example"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "source": {
      "description": "Where this knowledge comes from (URL, document, person).",
      "type": "string",
      "maxLength": 500
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential"
      ],
      "default": "internal"
    }
  }
}
