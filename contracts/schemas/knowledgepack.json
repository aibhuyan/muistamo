{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/knowledgepack.json",
  "title": "KnowledgePack",
  "description": "A versioned, reviewed body of company knowledge (PRD section 5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "muistamo.dev/v1"
    },
    "kind": {
      "type": "string",
      "const": "KnowledgePack"
    },
    "metadata": {
      "$ref": "common/objectmeta.json"
    },
    "spec": {
      "title": "KnowledgePackSpec",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "string",
          "enum": [
            "company",
            "role",
            "team"
          ],
          "description": "Personal layers are per person and are not packs."
        },
        "mandatory": {
          "description": "Company packs only. Users and agents cannot switch a mandatory pack off or shadow its entries: for its keys it wins over every other layer. Only privacy officers can set or clear it, or change a mandatory pack in any other way.",
          "type": "boolean"
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "People (actor names) who may approve or reject proposals and roll back versions.",
          "minItems": 1
        },
        "mergePolicy": {
          "title": "MergePolicy",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "review",
                  "evaluation"
                ]
              }
            }
          }
        },
        "decay": {
          "title": "DecayPolicy",
          "description": "How long a reviewer's confirmation of an entry lasts (FR-307). After reviewEveryDays the entry is due: still served, flagged and queued for the reviewers. After graceDays more it expires: never served, and removed from the pack by the next decay sweep. Mandatory packs never expire.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewEveryDays": { "type": "integer", "minimum": 1, "maximum": 3650, "default": 365 },
            "graceDays": { "type": "integer", "minimum": 0, "maximum": 365, "default": 30 }
          }
        },
        "storageLocation": {
          "description": "Customer-bound object storage location for pack content.",
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "mandatory": {
            "const": true
          }
        },
        "required": [
          "mandatory"
        ]
      },
      "then": {
        "properties": {
          "layer": {
            "const": "company"
          }
        }
      }
    }
  }
}
