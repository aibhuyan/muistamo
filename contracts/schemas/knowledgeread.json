{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/knowledgeread.json",
  "title": "KnowledgeRead",
  "description": "One retrieval a person made: what they were shown, never the query text (invariant 5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "person",
    "at",
    "tool",
    "resultCount",
    "citations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "person": {
      "type": "string"
    },
    "agent": {
      "description": "The agent instance the read was made through, for a person who signed in with Entra (the delegation's agent).",
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "string",
      "enum": [
        "rest.retrieve",
        "mcp.search_knowledge"
      ]
    },
    "resultCount": {
      "type": "integer",
      "minimum": 0
    },
    "citations": {
      "type": "array",
      "items": {
        "title": "ReadCitation",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "entry",
              "document"
            ]
          },
          "entryKey": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "pack": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          }
        }
      }
    }
  }
}
