{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/knowledgesourcerecord.json",
  "title": "KnowledgeSourceRecord",
  "description": "A source and its index state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "documentCount",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "document": {
      "$ref": "knowledgesource.json"
    },
    "documentCount": {
      "type": "integer"
    },
    "lastSyncedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
