{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/modelapproval.json",
  "title": "ModelApproval",
  "description": "Where a catalogue model's approval stands. A change to the model's document resets it to pending.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "revoked"
      ]
    },
    "decidedBy": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
