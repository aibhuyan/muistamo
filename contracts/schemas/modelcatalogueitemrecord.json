{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/modelcatalogueitemrecord.json",
  "title": "ModelCatalogueItemRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "createdAt",
    "updatedAt",
    "updatedBy",
    "document",
    "approval"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedBy": {
      "type": "string"
    },
    "document": {
      "$ref": "modelcatalogueitem.json"
    },
    "approval": {
      "$ref": "modelapproval.json"
    }
  }
}
