{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/personalentry.json",
  "title": "PersonalEntry",
  "description": "An entry in the caller's own personal layer, with whether it is private (D59). Only the owner ever sees this view.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "key",
    "type",
    "title",
    "body",
    "dataClass",
    "contributor",
    "createdAt",
    "private"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "key": {
      "description": "Stable key; the most specific layer wins for the same key.",
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 120
    },
    "type": {
      "type": "string",
      "enum": [
        "skill",
        "fact",
        "example"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential"
      ]
    },
    "contributor": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "private": {
      "description": "Private entries are never proposed, never shown in a leaver review, and are purged when the person leaves (D59).",
      "type": "boolean"
    }
  }
}
