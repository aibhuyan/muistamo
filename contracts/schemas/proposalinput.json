{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/proposalinput.json",
  "title": "ProposalInput",
  "description": "Propose personal entries to a pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack",
    "entryIds",
    "summary"
  ],
  "properties": {
    "pack": {
      "type": "string"
    },
    "entryIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
