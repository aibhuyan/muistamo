{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muistamo.dev/schemas/v1/resolvedentry.json",
  "title": "ResolvedEntry",
  "description": "An effective entry for the caller, and where it came from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry",
    "layer"
  ],
  "properties": {
    "entry": {
      "$ref": "knowledgeentry.json"
    },
    "layer": {
      "type": "string",
      "enum": [
        "personal",
        "team",
        "role",
        "company"
      ]
    },
    "pack": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "mandatory": {
      "description": "The entry comes from a mandatory pack, so no other layer can replace it.",
      "type": "boolean"
    },
    "decay": {
      "description": "Pack entries only: when a reviewer last vouched for it. Expired entries are never resolved.",
      "$ref": "entrydecay.json"
    },
    "provenance": {
      "$ref": "provenance.json"
    },
    "overrides": {
      "description": "Entries with the same key that this mandatory entry overrides, for example the caller's own personal entry.",
      "type": "array",
      "items": {
        "title": "ResolvedOverride",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer"
        ],
        "properties": {
          "layer": {
            "type": "string",
            "enum": [
              "personal",
              "team",
              "role",
              "company"
            ]
          },
          "pack": {
            "type": "string"
          }
        }
      }
    }
  }
}
